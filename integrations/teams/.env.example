# Microsoft Entra/Bot registration
TEAMS_BOT_APP_ID=11111111-1111-4111-8111-111111111111
TEAMS_BOT_CLIENT_SECRET=replace-with-secret-manager-value
TEAMS_BOT_TENANT_ID=22222222-2222-4222-8222-222222222222

# Comma-separated resource tenants allowed to use this bot
TEAMS_ALLOWED_TENANT_IDS=22222222-2222-4222-8222-222222222222

# Durable retry/idempotency state (share this database only on one filesystem host)
TEAMS_DEDUPE_DATABASE=./var/teams-dedupe.sqlite3
TEAMS_DEDUPE_RETENTION_DAYS=7
TEAMS_DEDUPE_MAX_RECORDS=100000
PORT=3978
