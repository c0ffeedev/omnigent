# Microsoft Entra/Bot registration
TEAMS_BOT_APP_ID=11111111-1111-4111-8111-111111111111
TEAMS_BOT_CLIENT_SECRET=replace-with-secret-manager-value
TEAMS_BOT_TENANT_ID=22222222-2222-4222-8222-222222222222

# Comma-separated resource tenants allowed to use this bot
TEAMS_ALLOWED_TENANT_IDS=22222222-2222-4222-8222-222222222222

# Teams SSO connection. The audience must exactly match the Entra exposed API URI.
TEAMS_SSO_AUDIENCE=api://bot.example.com/11111111-1111-4111-8111-111111111111
TEAMS_SSO_CONNECTION_NAME=teams-sso

# Fixed Omnigent deployment and narrow RFC 8628 client (interactive scope only)
OMNIGENT_ORIGIN=https://omnigent.example.com
OMNIGENT_DEVICE_CLIENT_ID=teams-device-client
# Set only when the registered device client is confidential.
# OMNIGENT_DEVICE_CLIENT_SECRET=replace-with-secret-manager-value

# Durable encrypted delegated grants. Generate a 32-byte key with:
# openssl rand -base64 32
TEAMS_GRANT_DATABASE=./var/teams-grants.sqlite3
TEAMS_TOKEN_ENCRYPTION_KEY=replace-with-base64-encoded-32-byte-key

# Durable retry/idempotency state (share this database only on one filesystem host)
TEAMS_DEDUPE_DATABASE=./var/teams-dedupe.sqlite3
TEAMS_DEDUPE_RETENTION_DAYS=7
TEAMS_DEDUPE_MAX_RECORDS=100000
PORT=3978
