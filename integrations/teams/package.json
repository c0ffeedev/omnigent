{
  "name": "@omnigent/teams",
  "version": "0.1.0",
  "private": true,
  "description": "Authenticated Microsoft Teams transport for Omnigent",
  "type": "module",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "start": "node dist/index.js",
    "dev": "tsx src/index.ts",
    "test": "vitest run",
    "typecheck": "tsc --noEmit",
    "lint": "oxlint src tests"
  },
  "dependencies": {
    "@microsoft/teams.api": "2.0.14",
    "@microsoft/teams.apps": "2.0.14",
    "better-sqlite3": "12.11.1"
  },
  "devDependencies": {
    "@types/better-sqlite3": "7.6.13",
    "@types/node": "22.18.12",
    "oxlint": "1.62.0",
    "tsx": "4.20.6",
    "typescript": "5.9.3",
    "vitest": "4.1.10"
  }
}
