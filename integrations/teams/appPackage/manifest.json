{
  "$schema": "https://developer.microsoft.com/json-schemas/teams/v1.20/MicrosoftTeams.schema.json",
  "manifestVersion": "1.20",
  "version": "0.1.0",
  "id": "${{TEAMS_APP_ID}}",
  "name": {
    "short": "Omnigent",
    "full": "Omnigent personal assistant"
  },
  "developer": {
    "name": "Omnigent",
    "websiteUrl": "https://${{BOT_DOMAIN}}",
    "privacyUrl": "https://${{BOT_DOMAIN}}/privacy",
    "termsOfUseUrl": "https://${{BOT_DOMAIN}}/terms"
  },
  "description": {
    "short": "Use Omnigent from a personal Teams conversation.",
    "full": "An authenticated personal-scope Microsoft Teams transport for Omnigent. This initial slice provides transport verification and help only."
  },
  "icons": {
    "outline": "outline.png",
    "color": "color.png"
  },
  "accentColor": "#5B2C83",
  "staticTabs": [
    {
      "entityId": "conversations",
      "scopes": ["personal"]
    },
    {
      "entityId": "about",
      "scopes": ["personal"]
    }
  ],
  "bots": [
    {
      "botId": "${{BOT_APP_ID}}",
      "scopes": ["personal"],
      "isNotificationOnly": false,
      "supportsCalling": false,
      "supportsVideo": false,
      "supportsFiles": false
    }
  ],
  "validDomains": ["${{BOT_DOMAIN}}"]
}
